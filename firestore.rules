rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function getRol() {
      return exists(/databases/$(database)/documents/roles_usuarios/$(userEmail()))
        ? get(/databases/$(database)/documents/roles_usuarios/$(userEmail())).data.rol
        : '';
    }

    match /roles_usuarios/{email} {
      allow read: if request.auth != null && (request.auth.token.email.lower() == email.lower() || getRol() == 'admin');
      allow write: if request.auth != null && getRol() == 'admin';
    }

    match /solicitudes_acceso/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && getRol() == 'admin';
    }

    match /tareas_entregadas/{id} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && (getRol() == 'admin' || getRol() == 'editor');
    }
  }
}
